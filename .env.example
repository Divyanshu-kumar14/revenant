# Copy to .env.local for development. Never commit real values.

# --- Runtime -----------------------------------------------------------------
# Directory holding the SQLite database and uploaded images. Defaults to ./data.
REVENANT_DATA_DIR=./data

# Password for /admin. Required outside local development.
ADMIN_PASSWORD=replace-with-a-long-random-string

# Signs the admin session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-bytes-of-hex

# --- Extraction --------------------------------------------------------------
# "fixture" replays recorded extractions with no network access; "provider" calls
# the vision model below. Tests always use "fixture".
EXTRACTOR=fixture

# Which adapter `EXTRACTOR=provider` uses.
VISION_PROVIDER=gemini

# Gemini. Key from https://aistudio.google.com/apikey — put it in .env.local only.
# GEMINI_API_KEY is read too; either name works.
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Publication -------------------------------------------------------------
# Used verbatim in item citations.
INSTITUTION_NAME=Cedar County Historical Society
# Absolute origin used to build citation URLs, e.g. https://revenant.example.org
APP_BASE_URL=http://localhost:3000

# --- Geocoding ---------------------------------------------------------------
# Nominatim requires a descriptive User-Agent with a contact address.
NOMINATIM_USER_AGENT=revenant/0.1 (archive-tool; you@example.org)
