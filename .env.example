# Copy to .env.local for development. Never commit real values.

# --- Runtime -----------------------------------------------------------------
# Directory holding the SQLite database and uploaded images. Defaults to ./data.
REVENANT_DATA_DIR=./data

# Password for /admin. Required outside local development.
ADMIN_PASSWORD=replace-with-a-long-random-string

# Signs the admin session cookie. Must be at least 32 characters.
# Generate a real one (64 hex characters) with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32

# --- Extraction --------------------------------------------------------------
# "provider" calls the vision model below; "fixture" returns one fixed, obviously
# fake extraction and reads no image or network. Tests always use "fixture".
EXTRACTOR=provider

# Which adapter `EXTRACTOR=provider` uses. NIM is the provider the accuracy gate in
# docs/decisions/0001-extraction-promise.md was measured on.
VISION_PROVIDER=nim

# Shared by both adapters: it must match VISION_PROVIDER. The NIM adapter refuses a
# googleapis.com URL so a NIM key is never sent to Google.
VISION_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA NIM. Key from https://build.nvidia.com; put it in .env.local only.
# NVAPI_API_KEY is read too; either name works.
NVIDIA_API_KEY=
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Alternative: Gemini (not measured by the accuracy gate). To use it, comment out
# VISION_PROVIDER and VISION_BASE_URL above and uncomment these lines.
# Key from https://aistudio.google.com/apikey; put it in .env.local only.
# GEMINI_API_KEY is read too; either name works.
# VISION_PROVIDER=gemini
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VISION_MODEL=gemini-2.5-flash
# VISION_API_KEY=

# --- Publication -------------------------------------------------------------
# Used verbatim in item citations.
INSTITUTION_NAME=Cedar County Historical Society
# Absolute origin used to build citation URLs, e.g. https://revenant.example.org
APP_BASE_URL=http://localhost:3000

# --- Geocoding ---------------------------------------------------------------
# Nominatim requires a descriptive User-Agent with a contact address.
NOMINATIM_USER_AGENT=revenant/0.1 (archive-tool; you@example.org)
